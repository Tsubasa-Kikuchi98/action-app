# OpenAI API キー（必須）: https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=

# ElevenLabs API キー（BGM を API で生成する場合のみ。未設定なら assets/bgm/ のフリー素材を使う）
ELEVENLABS_API_KEY=

# 画像生成の既定（開発中は low、本番は medium）
IMG_QUALITY=low
IMG_SIZE=1536x1024

# Google Gemini API キー（Phase 2 動画生成。Google AI Studio で発行＋課金有効化。無料枠なし）
GEMINI_API_KEY=

# ナレーション速度（既定 1.15）
TTS_SPEED=1.15
