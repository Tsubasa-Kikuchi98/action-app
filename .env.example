# OpenAI API キー（必須）: https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=

# ElevenLabs API キー（BGM を API で生成する場合のみ。未設定なら assets/bgm/ のフリー素材を使う）
# BGM（/v1/music）と効果音（/v1/sound-generation）に使う。未設定なら ffmpeg の合成音にフォールバック
ELEVENLABS_API_KEY=

# 画像生成の既定（開発中は low、本番は medium）
IMG_QUALITY=low
IMG_SIZE=1536x1024

# Google Gemini API キー（Phase 2 動画生成。Google AI Studio で発行＋課金有効化。無料枠なし）
GEMINI_API_KEY=

# Veo（Phase 2 動画生成）の調整
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_CONCURRENCY=3
VEO_TIMEOUT_SEC=480
# 1 ジョブで生成してよい合計秒数の上限（$0.05/秒。超えると実行前に停止する）
VEO_BUDGET_SEC=48
# シーン尺の丸め（4/6/8 秒）を切る場合は off
SCENE_ROUND=on

# ナレーション速度（Phase 3 で 1.0 に変更。速度は instructions の Pacing: で制御する）
TTS_SPEED=1.0
# ナレ voice。セリフ（dialogue）はここと違う声が自動で選ばれる（ash / onyx / nova / shimmer）
TTS_VOICE=cedar
# TTS の前後の無音を自動で削る（off で無効）
TTS_TRIM=on

# --- Phase 3: 編集・演出（render.mjs） ---
# 環境音（Veo 同梱音声）の音量。0.25 → 0.9 で「主役級」に。ナレ中だけダッキングされる
AMBIENT_VOL=0.9
# 各クリップの環境音をこの mean dBFS に揃えてから使う
AMBIENT_TARGET_DB=-20
# セリフ / BGM の音量
DLG_VOL=1.0
BGM_VOL=0.22
# レターボックス（2.39:1 は 138px）
LETTERBOX=138
# カード類の尺（秒）
PRESENTS_SEC=1.4
INTER_SEC=1.05
STOPDOWN_SEC=0.5
TITLE_SEC=3.4
# cold_open → setup の唯一のクロスディゾルブ（0 でハードカットのみに）
XFADE_SEC=0.45

# Veo は 8 秒生成 → render 側で前半だけ使う（fit にすると台本の尺に合わせる）
VEO_GEN_SEC=8
