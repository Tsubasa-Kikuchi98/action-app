# OpenAI API キー（必須）: https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=

# ElevenLabs API キー（BGM を API で生成する場合のみ。未設定なら assets/bgm/ のフリー素材を使う）
ELEVENLABS_API_KEY=

# 画像生成の既定（開発中は low、本番は medium）
IMG_QUALITY=low
IMG_SIZE=1536x1024

# Google Gemini API キー（Phase 2 動画生成。Google AI Studio で発行＋課金有効化。無料枠なし）
GEMINI_API_KEY=

# Veo（Phase 2 動画生成）の調整
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_CONCURRENCY=3
VEO_TIMEOUT_SEC=480
# 1 ジョブで生成してよい合計秒数の上限（$0.05/秒。超えると実行前に停止する）
VEO_BUDGET_SEC=48
# シーン尺の丸め（4/6/8 秒）を切る場合は off
SCENE_ROUND=on

# ナレーション速度（既定 1.15）
TTS_SPEED=1.15
