node_modules/
# electron-builder の出力（portable exe）
dist/
# 配布 exe に同梱する ffmpeg / ffprobe（npm run prepare:ffmpeg でコピーする。約 420MB）
build/ffmpeg/
.env
.env.*
*.log
.DS_Store
Thumbs.db
__pycache__/
.venv/

# 生成物・素材
out/
assets/bgm/*.mp3
assets/bgm/*.wav
# 基準画像（キャラクターシート / ロケーションプレート）。ジョブ横断で使い回すが再生成できるので追跡しない。
assets/refs/*.png
!.env.example

# 効果音（ブラーム等）。ジョブ横断で使い回すが再生成できるので追跡しない。
assets/sfx/*.wav
assets/sfx/*.mp3
